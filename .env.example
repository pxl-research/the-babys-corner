# LLM
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NANO=gpt-5-nano
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v4

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
STAFF_EMAIL=

# Auth
STAFF_ADMIN_USERNAME=staff
STAFF_ADMIN_PASSWORD=
PXL_ADMIN_USERNAME=admin
PXL_ADMIN_PASSWORD=

# Catalog
CATALOG_PATH=/app/catalog/catalog_dummy.json

# App
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=false
# Comma-separated allowed CORS origins (credentialed requests forbid "*").
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DB
DATABASE_PATH=/app/data/sessions.db
