# LLM
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NANO=gpt-5-nano
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v4

# Email (SMTP) — required for the staff handoff mail. Leave blank to disable it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
STAFF_EMAIL=

# Auth
STAFF_ADMIN_USERNAME=staff
PXL_ADMIN_USERNAME=admin
# Required in production .env:
# STAFF_ADMIN_PASSWORD=<strong unique password>
# PXL_ADMIN_PASSWORD=<strong unique password>

# Catalog
# Container path (Docker Compose). When this path does not exist the app falls
# back to backend/catalog/catalog.json, so local runs need no override.
CATALOG_PATH=/app/catalog/catalog.json

# App
APP_ENV=development
SESSION_COOKIE_SECURE=false
# Required in production .env:
# APP_ENV=production
# SESSION_SECRET_KEY=<generate 32+ random characters>
# SESSION_COOKIE_SECURE=true
# Comma-separated allowed CORS origins (credentialed requests forbid "*").
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production deployment:
# PUBLIC_DOMAIN=example.com
# APP_ENV=production
# SESSION_COOKIE_SECURE=true
# CORS_ORIGINS=https://example.com

# DB
# Container path (Docker Compose). Locally, e.g. DATABASE_PATH=backend/data/sessions.db
DATABASE_PATH=/app/data/sessions.db
